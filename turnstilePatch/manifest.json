{
    "manifest_version": 3,
    "name": "Turnstile Patcher",
    "version": "2.1",
    "content_scripts": [
        {
            "matches": ["<all_urls>"],
            "js": ["./script.js"],
            "run_at": "document_start",
            "all_frames": true,
            "world": "MAIN"
        }
    ]
}